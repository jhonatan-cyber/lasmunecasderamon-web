---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/landing/Navigation.astro";
import Footer from "../components/landing/Footer.astro";
import AmbientFx from "../components/landing/AmbientFx.astro";
import WhatsAppWidget from "../components/landing/WhatsAppWidget.astro";
import HeroSection from "../components/landing/HeroSection.astro";
import AboutSection from "../components/landing/AboutSection.astro";
import EventsSection from "../components/landing/EventsSection.astro";
import ServicesSection from "../components/landing/ServicesSection.astro";
import TestimonialsSection from "../components/landing/TestimonialsSection.astro";
import InstagramSection from "../components/landing/InstagramSection.astro";
import GallerySection from "../components/landing/GallerySection.astro";
import LocationSection from "../components/landing/LocationSection.astro";
import CareersSection from "../components/landing/CareersSection.astro";
import ReviewsSection from "../components/landing/ReviewsSection.astro";
---

<BaseLayout
  title="Las Muñecas de Ramón"
  description="Vive la mejor experiencia VIP en Las Muñecas de Ramón, el nightclub más exclusivo de Linares. Shows en vivo, salas VIP y tragos premium."
>
  <Navigation slot="nav" />
  <Footer slot="footer" />
  <Fragment slot="floating">
    <AmbientFx />
    <WhatsAppWidget />
  </Fragment>

  <div class="landing-shell relative min-h-screen overflow-x-hidden">
    <a
      href="#home"
      class="landing-skip-link sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[70] focus:rounded-full focus:bg-white focus:px-4 focus:py-2 focus:text-black"
    >
      Saltar al contenido principal
    </a>

    <HeroSection />
    <AboutSection />
    <EventsSection />
    <ServicesSection />
    <TestimonialsSection />
    <InstagramSection />
    <GallerySection />
    <LocationSection />
    <CareersSection />
    <ReviewsSection />
  </div>
</BaseLayout>
