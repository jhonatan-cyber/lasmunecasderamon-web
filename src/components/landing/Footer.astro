---
/**
 * Footer — mirrors the dashboard's Footer.tsx.
 * Includes the desktop logo, mobile logo, description, social icons,
 * quick links, schedule, contact, and legal links.
 */
import { SITE } from "../../lib/seo";

const TikTokIcon = (className = "w-5 h-5") => /* html */ `
  <svg viewBox="0 0 24 24" fill="currentColor" class="${className}">
    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
  </svg>
`;

const FacebookIcon = (className = "w-5 h-5") => /* html */ `
  <svg viewBox="0 0 24 24" fill="currentColor" class="${className}">
    <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/>
  </svg>
`;

const InstagramIcon = (className = "w-5 h-5") => /* html */ `
  <svg viewBox="0 0 24 24" fill="currentColor" class="${className}">
    <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.92 5.92 0 0 0-2.13 1.38A5.92 5.92 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.47 1.38 2.13a5.92 5.92 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.92 5.92 0 0 0 2.13-1.38 5.92 5.92 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91A5.92 5.92 0 0 0 21.99 2.01 5.92 5.92 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/>
  </svg>
`;

const menuItems = [
  { name: "Inicio", href: "#home" },
  { name: "Nosotros", href: "#about" },
  { name: "Servicios", href: "#services" },
  { name: "Ubicación", href: "#location" },
  { name: "Trabaja con Nosotros", href: "#careers" },
];

const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/10 bg-black pt-16 pb-10 sm:pt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 grid gap-8 sm:gap-12 md:grid-cols-4 md:mb-16">
      <div class="text-center md:col-span-2 md:text-left">
        <div class="mb-8 flex items-center justify-center space-x-3 md:justify-start">
          <img
            src="/img/system/logo2.png"
            alt={`${SITE.name} - Nightclub Exclusivo en Linares`}
            width="200"
            height="129"
            class="hidden md:block object-contain brightness-110 drop-shadow-lg"
            style="width: 200px; height: auto;"
          />
          <img
            src="/img/system/logo1.png"
            alt={`${SITE.name} - Nightclub Exclusivo en Linares`}
            width="160"
            height="80"
            class="md:hidden object-contain brightness-110 drop-shadow-lg"
            style="width: auto; height: 80px;"
          />
        </div>
        <p class="mb-8 max-w-md text-sm font-light leading-relaxed tracking-wide text-silver-400">
          El nightclub más exclusivo de Linares. Un lugar para caballeros que buscan experiencias únicas en un ambiente de lujo, sofisticación y discreción absoluta.
        </p>
        <div class="flex justify-center gap-4 md:justify-start">
          <a
            href={SITE.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="group flex h-12 w-12 min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-zinc-900 transition-all duration-300 hover:scale-110 hover:border-gold-500/50 hover:bg-zinc-800"
          >
            <Fragment set:html={FacebookIcon("w-5 h-5 text-silver-400 group-hover:text-gold-400 transition-colors")} />
          </a>
          <a
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="group flex h-12 w-12 min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-zinc-900 transition-all duration-300 hover:scale-110 hover:border-gold-500/50 hover:bg-zinc-800"
          >
            <Fragment set:html={InstagramIcon("w-5 h-5 text-silver-400 group-hover:text-gold-400 transition-colors")} />
          </a>
          <a
            href={SITE.social.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="group flex h-12 w-12 min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-full border border-white/10 bg-zinc-900 transition-all duration-300 hover:scale-110 hover:border-gold-500/50 hover:bg-zinc-800"
          >
            <Fragment set:html={TikTokIcon("w-5 h-5 text-silver-400 group-hover:text-gold-400 transition-colors")} />
          </a>
        </div>
      </div>

      <div>
        <h4 class="mb-6 text-lg font-medium uppercase tracking-widest text-gold-400 text-center md:mb-8 md:text-left">
          Enlaces Rápidos
        </h4>
        <ul class="space-y-4 text-center md:text-left">
          {
            menuItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center text-sm tracking-wide text-silver-500 transition-colors hover:text-gold-400"
                >
                  <span class="mr-3 h-1 w-1 rounded-full bg-gold-500/50 transition-colors group-hover:bg-gold-500" />
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h4 class="mb-6 text-lg font-medium uppercase tracking-widest text-gold-400 text-center md:mb-8 md:text-left">
          Horario
        </h4>
        <div class="space-y-6 text-center md:text-left">
          <div class="flex items-start justify-center gap-4 md:justify-start">
            <div class="rounded-full border border-white/5 bg-zinc-900 p-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </div>
            <div>
              <p class="font-medium tracking-wide text-silver-200">{SITE.hours.days}</p>
              <p class="mt-1 text-sm text-silver-500">{SITE.hours.open} - {SITE.hours.close} hrs</p>
            </div>
          </div>
          <div class="flex items-start justify-center gap-4 md:justify-start">
            <div class="rounded-full border border-white/5 bg-zinc-900 p-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
            </div>
            <div>
              <p class="font-medium tracking-wide text-silver-200">Contacto</p>
              <p class="mt-1 text-sm text-silver-500">{SITE.phone}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
        <p class="text-center text-xs uppercase tracking-wider text-silver-600 md:text-left">
          © {year} {SITE.name}. Todos los derechos reservados.
        </p>
        <div class="flex gap-8 text-xs uppercase tracking-wider">
          <a
            href="/terminos-y-condiciones"
            class="text-silver-600 transition-colors hover:text-gold-400"
          >
            Términos y Condiciones
          </a>
          <a
            href="/politica-de-privacidad"
            class="text-silver-600 transition-colors hover:text-gold-400"
          >
            Política de Privacidad
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
