---
import { SITE } from "../../lib/seo";

const year = new Date().getFullYear();
const iconClass = "h-5 w-5 transition-colors duration-300";
---

<footer class="relative overflow-hidden border-t border-white/10 bg-ink-950 pb-8 pt-5">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-500/60 to-transparent"></div>
  <div class="pointer-events-none absolute left-1/2 top-0 h-[220px] w-[520px] -translate-x-1/2 rounded-full glow-gold" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-white/10 bg-white/[0.05] px-6 py-5 sm:px-8">
      <div class="flex flex-col items-center gap-4 text-center text-sm text-white/60 lg:hidden">
        <a href="#home" class="flex items-center gap-3">
          <img
            src="/img/system/logo1-144.webp"
            alt={SITE.name}
            width="34"
            height="34"
            loading="lazy"
            decoding="async"
            class="object-contain drop-shadow-[0_0_10px_rgba(221,179,73,0.3)]"
            style="width: auto; height: 34px;"
          />
        </a>
        <p>&copy; {year} Todos los derechos reservados.</p>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <a href="/politica-de-privacidad" class="transition-colors duration-300 hover:text-gold-300">Privacidad</a>
          <span class="text-white/55">·</span>
          <a href="/cookies" class="transition-colors duration-300 hover:text-gold-300">Cookies</a>
          <span class="text-white/55">·</span>
          <a href="/terminos-y-condiciones" class="transition-colors duration-300 hover:text-gold-300">Términos</a>
        </div>
        <div class="flex items-center gap-4">
          <a href={SITE.social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="text-white/50 transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="none" class={iconClass} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a href={SITE.social.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer" class="text-white/50 transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass}>
              <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
            </svg>
          </a>
          <a href={SITE.social.tiktok} aria-label="TikTok" target="_blank" rel="noopener noreferrer" class="text-white/50 transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass}>
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
            </svg>
          </a>
        </div>
        <span class="text-xs">Desarrollado por <strong class="font-semibold text-white/70">Nuwesoft</strong></span>
      </div>

      <div class="relative hidden h-7 w-full items-center lg:flex">
        <p class="whitespace-nowrap text-sm text-white/60">&copy; {year} Todos los derechos reservados.</p>

        <div class="absolute left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap text-sm text-white/60">
          <a href="/politica-de-privacidad" class="transition-colors duration-300 hover:text-gold-300">Privacidad</a>
          <span class="text-white/55">·</span>
          <a href="/cookies" class="transition-colors duration-300 hover:text-gold-300">Cookies</a>
          <span class="text-white/55">·</span>
          <a href="/terminos-y-condiciones" class="transition-colors duration-300 hover:text-gold-300">Términos y Condiciones</a>
        </div>

        <div class="absolute right-0 top-1/2 flex -translate-y-1/2 items-center gap-3 whitespace-nowrap text-sm text-white/60">
          <span>Desarrollado por <strong class="font-semibold text-white/70">Nuwesoft</strong></span>
          <a href={SITE.social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="text-white/50 transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="none" class={iconClass} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a href={SITE.social.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer" class="text-white/50 transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass}>
              <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
            </svg>
          </a>
          <a href={SITE.social.tiktok} aria-label="TikTok" target="_blank" rel="noopener noreferrer" class="text-white/50 transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="currentColor" class={iconClass}>
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
