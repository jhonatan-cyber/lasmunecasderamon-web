---
import { SITE } from "../../lib/seo";

const year = new Date().getFullYear();
---

<footer class="relative bg-[color:var(--site-bg)] pt-4 pb-6 sm:pb-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 rounded-full border border-white/10 bg-white/[0.04] px-6 py-4 backdrop-blur-xl sm:mb-10 sm:px-8">
      <div class="flex flex-col items-center gap-3 text-center text-sm text-silver-400 lg:hidden">
        <p>&copy; {year} Todos los derechos reservados. Las Munecas de Ramon.</p>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <a href="/politica-de-privacidad" class="transition-colors duration-300 hover:text-gold-300">Privacidad</a>
          <span class="text-silver-600">·</span>
          <a href="/cookies" class="transition-colors duration-300 hover:text-gold-300">Cookies</a>
          <span class="text-silver-600">·</span>
          <a href="/terminos-y-condiciones" class="transition-colors duration-300 hover:text-gold-300">Terminos</a>
          <span class="text-silver-600">·</span>
          <span>Desarrollado por <strong class="font-semibold text-silver-300">Nuwesoft</strong></span>
        </div>
      </div>

      <div class="relative hidden h-7 w-full items-center lg:flex">
        <p class="whitespace-nowrap text-sm text-silver-400">&copy; {year} Todos los derechos reservados. Las Munecas de Ramon.</p>

        <div class="absolute left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap text-sm text-silver-400">
          <a href="/politica-de-privacidad" class="transition-colors duration-300 hover:text-gold-300">Privacidad</a>
          <span class="text-silver-600">·</span>
          <a href="/cookies" class="transition-colors duration-300 hover:text-gold-300">Cookies</a>
          <span class="text-silver-600">·</span>
          <a href="/terminos-y-condiciones" class="transition-colors duration-300 hover:text-gold-300">Terminos y Condiciones</a>
          <span class="text-silver-600">·</span>
    
        </div>

        <div class="absolute right-0 top-1/2 flex -translate-y-1/2 items-center gap-3 whitespace-nowrap text-sm text-silver-400">
          <span>Desarrollado por <strong class="font-semibold text-silver-300">Nuwesoft</strong></span>
          <a href={SITE.social.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a href={SITE.social.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer" class="transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z" />
            </svg>
          </a>
          <a href={SITE.social.tiktok} aria-label="TikTok" target="_blank" rel="noopener noreferrer" class="transition-colors duration-300 hover:text-gold-300">
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
