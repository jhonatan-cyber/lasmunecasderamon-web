---
import { SITE } from "../../lib/seo";

const menuItems = [
  { name: "Inicio", href: "#home" },
  { name: "Nosotros", href: "#about" },
  { name: "Eventos", href: "#events" },
  { name: "Servicios", href: "#services" },
  { name: "Galería", href: "#galeria" },
  { name: "Ubicación", href: "#location" },
];

const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "/landing";
const buildHref = (href: string) => (isHomePage ? href : `/${href}`);
---

<nav
  id="landing-nav"
  aria-label="Navegación principal"
  class="fixed inset-x-0 top-3 z-50 px-3 transition-all duration-500 sm:top-4 sm:px-6"
>
  <div
    data-nav-shell
    class="relative mx-auto grid h-16 w-full max-w-7xl grid-cols-[auto,1fr,auto] items-center rounded-full border border-white/10 bg-ink-900/70 px-3 shadow-[0_0_40px_rgba(221,179,73,0.08),0_12px_45px_rgba(0,0,0,0.6)] backdrop-blur-2xl transition-all duration-500 sm:h-[4.25rem] sm:px-4"
  >
    <a
      href="#home"
      id="landing-nav-logo"
      data-nav-item
      style="--nav-delay: 0ms;"
      class="hidden items-center gap-3 opacity-0 -translate-x-2 scale-95 transition-all duration-700 ease-out lg:flex lg:justify-self-start"
    >
      <img
        src="/img/system/logo2-480.webp"
        alt={`${SITE.name} - Nightclub exclusivo en Linares`}
        width="264"
        height="169"
        loading="eager"
        decoding="async"
        class="object-contain drop-shadow-[0_0_12px_rgba(221,179,73,0.35)] transition-all duration-500 ease-in-out hover:scale-110"
        style="width: 132px; height: auto;"
      />
    </a>

    <a
      href="#home"
      id="landing-nav-logo-mobile"
      class="absolute left-4 top-1/2 flex -translate-y-1/2 items-center gap-3 lg:hidden"
    >
      <img
        src="/img/system/logo1-144.webp"
        alt={`${SITE.name} - Nightclub exclusivo en Linares`}
        width="36"
        height="36"
        loading="eager"
        decoding="async"
        class="object-contain drop-shadow-[0_0_10px_rgba(221,179,73,0.35)] transition-all duration-500 ease-in-out"
        style="width: auto; height: 36px;"
      />
    </a>

    <div class="hidden items-center justify-center gap-4 xl:gap-6 lg:flex">
      {
        menuItems.map((item, index) => (
          <a
            href={buildHref(item.href)}
            data-nav-item
            data-nav-link
            data-nav-target={item.href.slice(1)}
            style={`--nav-delay: ${index * 55 + 60}ms; color: var(--site-fg);`}
            class="group relative inline-flex items-center self-center rounded-full px-2 py-1 text-[12px] font-bold uppercase leading-none tracking-[0.14em] opacity-80 transition-all duration-300 hover:text-gold-300 hover:opacity-100"
          >
            <span class="nav-active-indicator pointer-events-none absolute -inset-x-3 -inset-y-2 rounded-full bg-gold-500/15 opacity-0 shadow-[0_0_18px_rgba(221,179,73,0.35)] transition-all duration-300" />
            {item.name}
          </a>
        ))
      }
    </div>

    <div class="col-start-3 flex items-center justify-end gap-2 justify-self-end">

      <button
        type="button"
        id="mobile-menu-toggle"
        style="--nav-delay: 460ms;"
        aria-label="Abrir menú"
        aria-controls="landing-mobile-menu"
        aria-expanded="false"
        class="inline-flex min-h-10 min-w-10 self-center items-center justify-center rounded-full border border-white/15 bg-black/40 text-white transition-all duration-300 hover:border-gold-500/50 hover:text-gold-300 lg:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-[18px] w-[18px]"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="landing-mobile-menu"
    class="mx-auto mt-2 hidden w-[calc(100%-0.75rem)] max-w-7xl rounded-3xl border border-white/10 bg-ink-950/95 px-2 py-2 shadow-[0_18px_60px_rgba(0,0,0,0.7)] backdrop-blur-2xl sm:w-[calc(100%-3rem)] lg:hidden"
  >
    <div class="flex flex-col gap-1 p-2">
      {
        menuItems.map((item) => (
          <a
            href={buildHref(item.href)}
            class="mobile-nav-link block rounded-2xl px-4 py-2.5 text-sm font-semibold uppercase tracking-wide opacity-80 transition-all duration-300 hover:bg-gold-500/10 hover:text-gold-300 hover:opacity-100"
            style="color: var(--site-fg);"
            data-nav-link
            data-nav-target={item.href.slice(1)}
          >
            {item.name}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<script>
  (function () {
    var nav = document.getElementById("landing-nav");
    var toggle = document.getElementById("mobile-menu-toggle");
    var mobileMenu = document.getElementById("landing-mobile-menu");
    var mobileLinks = document.querySelectorAll(".mobile-nav-link");
    if (!nav || !toggle || !mobileMenu) return;

    var navEl = nav as HTMLElement;
    var toggleEl = toggle as HTMLElement;
    var mobileMenuEl = mobileMenu as HTMLElement;

    var navLinks = nav.querySelectorAll("[data-nav-link]");

    // Mismo desplazamiento que el ancla nativa, pero respetando prefers-reduced-motion
    // (behavior: "smooth" en JS ignora scroll-behavior: auto del CSS).
    var NAV_OFFSET = 112; // 7rem, igual que el scroll-margin-top de las secciones

    function scrollToTarget(hash: string) {
      var target = document.querySelector(hash);
      if (!target) return false;

      var top = 0;
      if (hash !== "#home" && target instanceof HTMLElement) {
        top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - NAV_OFFSET);
      }

      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: top, behavior: reduce ? "auto" : "smooth" });
      return true;
    }

    function setActiveTarget(targetId: string) {
      if (!targetId) return;

      Array.prototype.forEach.call(navLinks, function (link) {
        var isActive = link.getAttribute("data-nav-target") === targetId;
        var indicator = link.querySelector(".nav-active-indicator");

        link.setAttribute("aria-current", isActive ? "page" : "false");
        link.classList.toggle("text-gold-300", isActive);
        link.classList.toggle("opacity-100", isActive);
        link.classList.toggle("opacity-80", !isActive);

        if (indicator instanceof HTMLElement) {
          indicator.classList.toggle("opacity-100", isActive);
          indicator.classList.toggle("opacity-0", !isActive);
        }
      });
    }

    // Scroll-spy sin listener de scroll: una banda de 1px a un tercio del viewport
    // decide que seccion esta activa.
    var activeId = "";
    var sectionObserver: IntersectionObserver | null = null;

    // El observador solo avisa de que la linea de activacion cambio de seccion;
    // que seccion manda lo decide la posicion real, para que los huecos entre
    // secciones y el hero (100svh, se solapa con la siguiente) no dejen el menu
    // showing "Inicio" a media pagina.
    function pickActive() {
      var line = Math.max(120, Math.round(window.innerHeight * 0.33));
      var next = "home";

      for (var i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= line) next = sections[i].id;
      }

      if (next !== activeId) {
        activeId = next;
        setActiveTarget(next);
      }
    }

    function observeSections() {
      if (sectionObserver) sectionObserver.disconnect();

      var line = Math.max(120, Math.round(window.innerHeight * 0.33));
      sectionObserver = new IntersectionObserver(
        function () {
          pickActive();
        },
        {
          rootMargin:
            "-" + line + "px 0px -" + Math.max(0, window.innerHeight - line - 1) + "px 0px",
          threshold: 0,
        },
      );

      sections.forEach(function (section) {
        sectionObserver!.observe(section);
      });
      pickActive();
    }

    var isOpen = false;

    Array.prototype.forEach.call(navLinks, function (link) {
      link.addEventListener("click", function (event: MouseEvent) {
        var href = link.getAttribute("href");
        if (!href) return;

        var hash = href.indexOf("#") >= 0 ? href.slice(href.indexOf("#")) : "";
        var handled = hash ? scrollToTarget(hash) : false;
        if (handled) {
          event.preventDefault();
          if (hash.length > 1) {
            setActiveTarget(hash.slice(1));
          }
          isOpen = false;
          mobileMenuEl.classList.add("hidden");
          toggleEl.setAttribute("aria-expanded", "false");
          toggleEl.setAttribute("aria-label", "Abrir menú");
        }
      });
    });

    var sectionIds = ["home", "about", "events", "services", "galeria", "location"];
    var sections = sectionIds
      .map(function (id) {
        var element = document.getElementById(id);
        return element instanceof HTMLElement ? element : null;
      })
      .filter(Boolean) as HTMLElement[];

    toggleEl.addEventListener("click", function () {
      isOpen = !isOpen;
      mobileMenuEl.classList.toggle("hidden", !isOpen);
      toggleEl.setAttribute("aria-expanded", String(isOpen));
      toggleEl.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    Array.prototype.forEach.call(mobileLinks, function (link) {
      link.addEventListener("click", function () {
        isOpen = false;
        mobileMenuEl.classList.add("hidden");
        toggleEl.setAttribute("aria-expanded", "false");
        toggleEl.setAttribute("aria-label", "Abrir menú");
      });
    });

    var resizeTimer: number | undefined;
    window.addEventListener("resize", function () {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(observeSections, 150);
    });

    setActiveTarget(window.location.hash.replace("#", "") || "home");
    observeSections();

    requestAnimationFrame(function () {
      document.documentElement.classList.add("nav-ready");
    });
  })();
</script>
