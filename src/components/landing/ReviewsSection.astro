---
/**
 * ReviewsSection — review submission form. On submit, opens WhatsApp with
 * the review formatted as a message (no backend needed).
 */
import { SITE } from "../../lib/seo";

const starPath = "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";
---

<section id="reviews" class="relative overflow-hidden py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center sm:mb-20">
      <div class="eyebrow-badge mb-4">Comparte tu Experiencia</div>
      <h2 class="mb-6 text-3xl font-bold sm:text-5xl md:text-6xl">
        <span class="gradient-text-gold">Deja tu Reseña</span>
      </h2>
      <p class="mx-auto max-w-3xl text-base font-light text-silver-300 sm:text-xl">
        Comparte tu experiencia con otros clientes. Nos encantaría saber tu opinión.
      </p>
    </div>

    <form
      id="review-form"
      class="mx-auto max-w-2xl rounded-3xl border border-white/10 bg-black/40 p-6 shadow-2xl backdrop-blur-md transition-all duration-500 hover:border-gold-500/30 sm:p-10"
    >
      <div class="mb-8">
        <label for="review-nombre" class="mb-3 block text-sm font-medium uppercase tracking-wide text-silver-200">
          Tu Nombre <span class="text-gold-500">*</span>
        </label>
        <input
          id="review-nombre"
          name="nombre"
          type="text"
          required
          placeholder="Juan Pérez"
          class="w-full rounded-xl border border-white/10 bg-zinc-900/50 px-6 py-4 text-white placeholder:text-silver-600 transition-all duration-300 focus:border-gold-500/50 focus:bg-zinc-900/80 focus:outline-none"
        />
      </div>

      <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <label for="review-email" class="mb-3 block text-sm font-medium uppercase tracking-wide text-silver-200">Email</label>
          <input
            id="review-email"
            name="email"
            type="email"
            placeholder="tu@email.com"
            class="w-full rounded-xl border border-white/10 bg-zinc-900/50 px-6 py-4 text-white placeholder:text-silver-600 transition-all duration-300 focus:border-gold-500/50 focus:bg-zinc-900/80 focus:outline-none"
          />
        </div>
        <div>
          <label for="review-telefono" class="mb-3 block text-sm font-medium uppercase tracking-wide text-silver-200">Teléfono</label>
          <input
            id="review-telefono"
            name="telefono"
            type="tel"
            placeholder="+56 9 12345678"
            class="w-full rounded-xl border border-white/10 bg-zinc-900/50 px-6 py-4 text-white placeholder:text-silver-600 transition-all duration-300 focus:border-gold-500/50 focus:bg-zinc-900/80 focus:outline-none"
          />
        </div>
      </div>

      <div class="mb-8">
        <label class="mb-4 block text-sm font-medium uppercase tracking-wide text-silver-200">
          Calificación <span class="text-gold-500">*</span>
        </label>
        <div id="review-rating" class="flex flex-wrap gap-4" role="radiogroup" aria-label="Calificación">
          {[1, 2, 3, 4, 5].map((s) => (
            <button
              type="button"
              data-rating={s}
              aria-label={`Calificar con ${s} estrellas`}
              class="group inline-flex min-h-11 min-w-11 items-center justify-center transition-transform duration-200 hover:scale-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-zinc-700 transition-colors" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0">
                <path stroke-linecap="round" stroke-linejoin="round" d={starPath} />
              </svg>
            </button>
          ))}
        </div>
        <input type="hidden" name="rating" id="review-rating-value" value="0" />
      </div>

      <div class="mb-8">
        <label for="review-comentario" class="mb-3 block text-sm font-medium uppercase tracking-wide text-silver-200">
          Comentario <span class="text-gold-500">*</span>
        </label>
        <textarea
          id="review-comentario"
          name="comentario"
          rows={5}
          required
          placeholder="Comparte tu experiencia..."
          class="w-full resize-none rounded-xl border border-white/10 bg-zinc-900/50 px-6 py-4 text-white placeholder:text-silver-600 transition-all duration-300 focus:border-gold-500/50 focus:bg-zinc-900/80 focus:outline-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="btn-gold inline-flex w-full items-center justify-center gap-3 px-8 py-5 text-base shadow-xl shadow-gold-600/30 sm:text-lg min-h-11"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0">
          <path stroke-linecap="round" stroke-linejoin="round" d={starPath} />
        </svg>
        Publicar Reseña
      </button>

      <p class="mt-4 text-center text-xs text-silver-500">
        Al enviar, se abrirá WhatsApp con tu reseña pre-cargada.
      </p>
    </form>
  </div>
</section>

<script define:vars={{ phoneRaw: SITE.phoneRaw }}>
  (function () {
    var form = document.getElementById("review-form");
    if (!form) return;

    var ratingContainer = document.getElementById("review-rating");
    var ratingInput = document.getElementById("review-rating-value");
    if (!ratingContainer || !ratingInput) return;

    var stars = Array.prototype.slice.call(ratingContainer.querySelectorAll("button[data-rating]"));
    function paint(rating) {
      stars.forEach(function (btn) {
        var v = Number(btn.dataset.rating);
        var svg = btn.querySelector("svg");
        if (!svg) return;
        if (v <= rating) {
          svg.classList.add("text-gold-500", "fill-gold-500");
          svg.classList.remove("text-zinc-700", "fill-zinc-700");
          svg.style.filter = "drop-shadow(0 0 10px rgba(245,158,11,0.5))";
        } else {
          svg.classList.remove("text-gold-500", "fill-gold-500");
          svg.classList.add("text-zinc-700", "fill-zinc-700");
          svg.style.filter = "";
        }
      });
    }

    stars.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var v = Number(btn.dataset.rating);
        ratingInput.value = String(v);
        paint(v);
      });
    });
    paint(0);

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var nombre = String(fd.get("nombre") || "").trim();
      var email = String(fd.get("email") || "").trim();
      var telefono = String(fd.get("telefono") || "").trim();
      var rating = Number(fd.get("rating") || 0);
      var comentario = String(fd.get("comentario") || "").trim();

      if (!nombre || !comentario || rating === 0) {
        alert("Por favor completa nombre, comentario y calificación.");
        return;
      }

      var starsText = "★".repeat(rating) + "☆".repeat(5 - rating);
      var msg = "Hola, quiero dejar mi reseña en Las Muñecas de Ramón:%0A%0A" +
        "Nombre: " + nombre + "%0A" +
        "Email: " + (email || "(no proporcionado)") + "%0A" +
        "Teléfono: " + (telefono || "(no proporcionado)") + "%0A" +
        "Calificación: " + starsText + " (" + rating + "/5)%0A%0A" +
        "Comentario:%0A" + comentario;

      var url = "https://wa.me/" + phoneRaw + "?text=" + msg;
      window.open(url, "_blank", "noopener,noreferrer");
    });
  })();
</script>
