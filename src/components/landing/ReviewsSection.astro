---
import { SITE } from "../../lib/seo";

const starPath = "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";
---

<section id="reviews" class="relative overflow-hidden py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 text-center scroll-reveal sm:mb-12">
      <p class="eyebrow-badge mb-5">Comparte tu Experiencia</p>
      <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-5xl md:text-6xl">
        <span class="text-white">Deja tu</span>
        <span class="gradient-text-gold"> reseña</span>
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm font-light text-white/55 sm:text-base">
        Cuéntanos cómo fue tu experiencia. Tu opinión nos ayuda a mejorar.
      </p>
    </div>

    <form
      id="review-form"
      class="glass-card mx-auto max-w-xl p-6 scroll-reveal sm:p-8"
      style="--reveal-delay: 100ms;"
    >
      <div class="mb-5">
        <label for="review-nombre" class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-white/60">
          Tu Nombre <span class="text-gold-400">*</span>
        </label>
        <input
          id="review-nombre"
          name="nombre"
          type="text"
          required
          placeholder="Juan Pérez"
          class="input-brand"
        />
      </div>

      <div class="mb-5 grid grid-cols-1 gap-4 md:grid-cols-2">
        <div>
          <label for="review-email" class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-white/60">Email</label>
          <input
            id="review-email"
            name="email"
            type="email"
            placeholder="tu@email.com"
            class="input-brand"
          />
        </div>
        <div>
          <label for="review-telefono" class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-white/60">Teléfono</label>
          <input
            id="review-telefono"
            name="telefono"
            type="tel"
            placeholder="+56 9 12345678"
            class="input-brand"
          />
        </div>
      </div>

      <div class="mb-5">
        <label class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-white/60">
          Calificación <span class="text-gold-400">*</span>
        </label>
        <div id="review-rating" class="flex flex-wrap gap-2" role="radiogroup" aria-label="Calificación">
          {[1, 2, 3, 4, 5].map((s) => (
            <button
              type="button"
              data-rating={s}
              aria-label={`Calificar con ${s} estrellas`}
              class="group inline-flex min-h-10 min-w-10 items-center justify-center transition-transform duration-200 hover:scale-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white/45 transition-colors" fill="currentColor" viewBox="0 0 24 24" stroke="none">
                <path stroke-linecap="round" stroke-linejoin="round" d={starPath} />
              </svg>
            </button>
          ))}
        </div>
        <input type="hidden" name="rating" id="review-rating-value" value="0" />
      </div>

      <div class="mb-6">
        <label for="review-comentario" class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-white/60">
          Comentario <span class="text-gold-400">*</span>
        </label>
        <textarea
          id="review-comentario"
          name="comentario"
          rows={4}
          required
          placeholder="Comparte tu experiencia..."
          class="input-brand resize-none"></textarea>
      </div>

      <button type="submit" class="btn-gold w-full px-6 py-4 text-sm sm:text-base">
        Publicar Reseña
      </button>

      <p class="mt-4 text-center text-[11px] text-white/60">
        Al enviar, se abrirá WhatsApp con tu reseña pre-cargada.
      </p>
    </form>
  </div>
</section>

<script is:inline define:vars={{ phoneRaw: SITE.phoneRaw }}>
  (function () {
    var form = document.getElementById("review-form");
    if (!form) return;

    var ratingContainer = document.getElementById("review-rating");
    var ratingInput = document.getElementById("review-rating-value");
    if (!ratingContainer || !ratingInput) return;

    var stars = Array.prototype.slice.call(ratingContainer.querySelectorAll("button[data-rating]"));
    function paint(rating) {
      stars.forEach(function (btn) {
        var v = Number(btn.dataset.rating);
        var svg = btn.querySelector("svg");
        if (!svg) return;
        if (v <= rating) {
          svg.classList.remove("text-white/45");
          svg.classList.add("text-gold-400");
          svg.style.filter = "drop-shadow(0 0 8px rgba(221,179,73,0.6))";
        } else {
          svg.classList.remove("text-gold-400");
          svg.classList.add("text-white/45");
          svg.style.filter = "";
        }
      });
    }

    stars.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var v = Number(btn.dataset.rating);
        ratingInput.value = String(v);
        paint(v);
      });
    });
    paint(0);

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      var nombre = String(fd.get("nombre") || "").trim();
      var email = String(fd.get("email") || "").trim();
      var telefono = String(fd.get("telefono") || "").trim();
      var rating = Number(fd.get("rating") || 0);
      var comentario = String(fd.get("comentario") || "").trim();

      if (!nombre || !comentario || rating === 0) {
        alert("Por favor completa nombre, comentario y calificación.");
        return;
      }

      var starsText = "★".repeat(rating) + "☆".repeat(5 - rating);
      var msg = "Hola, quiero dejar mi reseña en Las Muñecas de Ramón:%0A%0A" +
        "Nombre: " + nombre + "%0A" +
        "Email: " + (email || "(no proporcionado)") + "%0A" +
        "Teléfono: " + (telefono || "(no proporcionado)") + "%0A" +
        "Calificación: " + starsText + " (" + rating + "/5)%0A%0A" +
        "Comentario:%0A" + comentario;

      var url = "https://wa.me/" + phoneRaw + "?text=" + msg;
      window.open(url, "_blank", "noopener,noreferrer");
    });
  })();
</script>
