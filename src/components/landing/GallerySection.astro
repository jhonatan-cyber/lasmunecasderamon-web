---
type Category = "club" | "eventos" | "momentos";

type GalleryItem = {
  id: string;
  alt: string;
  caption: string;
  category: Category;
  square?: boolean;
};

const items: GalleryItem[] = [
  { id: "about-1", alt: "Instalaciones del club", caption: "Nuestro local", category: "club" },
  { id: "instagram-1", alt: "Noche de club", caption: "Noche de club", category: "momentos", square: true },
  { id: "events-1", alt: "Despedidas de soltero", caption: "Despedidas de soltero", category: "eventos" },
  { id: "instagram-2", alt: "Shows en vivo", caption: "Shows en vivo", category: "momentos", square: true },
  { id: "about-2", alt: "Ambiente e iluminación", caption: "Ambiente e iluminación", category: "club" },
  { id: "events-2", alt: "Fiestas privadas", caption: "Fiestas privadas", category: "eventos" },
  { id: "instagram-3", alt: "Barra premium", caption: "Barra premium", category: "momentos", square: true },
  { id: "about-3", alt: "Bar y coctelería premium", caption: "Bar premium", category: "club" },
  { id: "events-3", alt: "Quincho privado", caption: "Quincho privado", category: "eventos" },
  { id: "instagram-4", alt: "Fiestas del club", caption: "Fiestas", category: "momentos", square: true },
  { id: "about-4", alt: "Sala VIP", caption: "Salas VIP", category: "club" },
  { id: "events-4", alt: "Eventos VIP", caption: "Eventos VIP", category: "eventos" },
  { id: "instagram-5", alt: "Zona VIP", caption: "Zona VIP", category: "momentos", square: true },
  { id: "instagram-6", alt: "Linares de noche", caption: "Linares", category: "momentos", square: true },
];

const widths = (item: GalleryItem) => (item.square ? [300, 600] : [480, 800, 1200]);
const photoSrc = (id: string, w: number) => `/img/${id}-${w}.webp`;
const srcset = (item: GalleryItem) =>
  widths(item)
    .map((w) => `${photoSrc(item.id, w)} ${w}w`)
    .join(", ");
const defaultSrc = (item: GalleryItem) => photoSrc(item.id, item.square ? 600 : 800);
const fullSrc = (item: GalleryItem) => photoSrc(item.id, item.square ? 600 : 1200);
const sizes = "(min-width: 1280px) 23vw, (min-width: 768px) 31vw, 46vw";

const filters: { value: "all" | Category; label: string }[] = [
  { value: "all", label: "Todas" },
  { value: "club", label: "El Club" },
  { value: "eventos", label: "Eventos" },
  { value: "momentos", label: "Momentos" },
];
---

<section id="galeria" class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute right-1/4 top-10 h-[420px] w-[420px] rounded-full glow-gold" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex flex-col gap-8 scroll-reveal lg:mb-12 lg:flex-row lg:items-end lg:justify-between">
      <div class="text-center lg:text-left">
        <p class="eyebrow-badge mb-5">Galería</p>
        <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-6xl md:text-7xl">
          <span class="text-white">Revive la</span>
          <span class="gradient-text-gold"> noche</span>
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-sm font-light leading-relaxed text-white/55 sm:text-base lg:mx-0">
          Un vistazo a nuestras instalaciones, eventos y momentos. Toca cualquier foto para verla en grande.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2" role="group" aria-label="Filtrar galería por categoría">
        {
          filters.map((filter) => (
            <button
              type="button"
              class="gallery-filter rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/60 backdrop-blur-md transition-all duration-300 hover:border-gold-500/50 hover:text-gold-200"
              data-gallery-filter={filter.value}
              aria-pressed={filter.value === "all" ? "true" : "false"}
            >
              {filter.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="gallery-grid scroll-reveal" style="--reveal-delay: 100ms;">
      {
        items.map((item) => (
          <button
            type="button"
            class="gallery-item group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] text-left transition-colors duration-300 hover:border-gold-500/45 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400/70"
            data-gallery-item
            data-category={item.category}
            data-full={fullSrc(item)}
            data-caption={item.caption}
            aria-haspopup="dialog"
            aria-label={`Ampliar foto: ${item.caption}`}
          >
            <img
              src={defaultSrc(item)}
              srcset={srcset(item)}
              sizes={sizes}
              alt={item.alt}
              width={item.square ? 600 : 800}
              height={item.square ? 600 : 533}
              loading="lazy"
              decoding="async"
              class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.06]"
            />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/90 via-ink-950/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true" />
            <span class="pointer-events-none absolute inset-x-0 bottom-0 flex translate-y-1 items-center justify-between gap-3 p-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-white">{item.caption}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 shrink-0 text-gold-300" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
              </svg>
            </span>
            <span class="pointer-events-none absolute left-3 top-3 rounded-full border border-gold-500/40 bg-black/75 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-gold-200 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
              Ver
            </span>
          </button>
        ))
      }
    </div>

    <p data-gallery-count class="mt-6 text-center text-[11px] uppercase tracking-[0.22em] text-white/60"></p>
  </div>

  <dialog id="gallery-lightbox" class="gallery-lightbox" aria-label="Visor de fotos de la galería">
    <div data-lightbox-panel class="gallery-lightbox-panel relative flex h-full w-full flex-col items-center justify-center gap-4 p-4 sm:p-8">
      <button
        type="button"
        data-lightbox-close
        aria-label="Cerrar visor"
        class="absolute right-4 top-4 z-20 flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-black/50 text-white transition-colors duration-300 hover:border-gold-500/60 hover:text-gold-300 sm:right-6 sm:top-6"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>

      <div data-lightbox-stage class="relative flex w-full max-w-5xl flex-1 items-center justify-center">
        <img
          data-lightbox-img
          src=""
          alt=""
          class="max-h-[72vh] w-auto max-w-full rounded-2xl border border-white/15 object-contain shadow-[0_30px_90px_rgba(0,0,0,0.8)] transition-opacity duration-300"
        />
      </div>

      <div class="flex items-center gap-6">
        <button
          type="button"
          data-lightbox-prev
          aria-label="Foto anterior"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-black/50 text-white transition-colors duration-300 hover:border-gold-500/60 hover:text-gold-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="flex min-w-[11rem] flex-col items-center gap-1 text-center" aria-live="polite">
          <span data-lightbox-caption class="font-display text-sm uppercase tracking-[0.18em] text-white sm:text-base"></span>
          <span data-lightbox-counter class="text-[11px] uppercase tracking-[0.22em] text-white/60"></span>
        </div>

        <button
          type="button"
          data-lightbox-next
          aria-label="Foto siguiente"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-black/50 text-white transition-colors duration-300 hover:border-gold-500/60 hover:text-gold-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  (function () {
    var section = document.getElementById("galeria");
    var dialog = document.getElementById("gallery-lightbox") as HTMLDialogElement | null;
    if (!section || !dialog) return;

    var items = Array.prototype.slice.call(
      section.querySelectorAll("[data-gallery-item]")
    ) as HTMLElement[];
    if (items.length === 0) return;

    var imgEl = dialog.querySelector("[data-lightbox-img]") as HTMLImageElement | null;
    var captionEl = dialog.querySelector("[data-lightbox-caption]");
    var counterEl = dialog.querySelector("[data-lightbox-counter]");
    var countNote = section.querySelector("[data-gallery-count]");
    var filterButtons = Array.prototype.slice.call(
      section.querySelectorAll("[data-gallery-filter]")
    ) as HTMLButtonElement[];

    var visible: HTMLElement[] = items.slice();
    var current = 0;
    var lastTrigger: HTMLElement | null = null;
    var previousOverflow = "";
    var isOpen = false;

    function refreshVisible() {
      visible = items.filter(function (el) {
        return !el.hasAttribute("hidden");
      });
    }

    function updateCountNote() {
      if (!countNote) return;
      countNote.textContent =
        visible.length + (visible.length === 1 ? " foto" : " fotos");
    }

    function preload(index: number) {
      var target = visible[index];
      if (!target) return;
      var src = target.getAttribute("data-full");
      if (!src) return;
      var image = new Image();
      image.src = src;
    }

    function showCurrent() {
      var el = visible[current];
      if (!el || !imgEl) return;

      var full = el.getAttribute("data-full") || "";
      var caption = el.getAttribute("data-caption") || "";
      var tileImg = el.querySelector("img");

      imgEl.classList.add("is-loading");
      imgEl.removeAttribute("srcset");
      imgEl.removeAttribute("sizes");
      imgEl.src = full;
      imgEl.alt = tileImg?.getAttribute("alt") || caption;

      if (captionEl) captionEl.textContent = caption;
      if (counterEl) counterEl.textContent = current + 1 + " / " + visible.length;

      preload((current + 1) % visible.length);
      preload((current - 1 + visible.length) % visible.length);
    }

    function openLightbox(trigger: HTMLElement) {
      var index = visible.indexOf(trigger);
      if (index < 0) return;
      current = index;
      lastTrigger = trigger;
      showCurrent();

      previousOverflow = document.body.style.overflow;
      isOpen = true;
      document.body.style.overflow = "hidden";

      if (typeof dialog!.showModal === "function") {
        dialog!.showModal();
      } else {
        dialog!.setAttribute("open", "");
      }
    }

    function closeLightbox() {
      if (!dialog!.open) {
        onClosed();
        return;
      }
      if (typeof dialog!.close === "function") {
        dialog!.close();
      } else {
        dialog!.removeAttribute("open");
      }
    }

    function step(delta: number) {
      if (visible.length === 0) return;
      current = (current + delta + visible.length) % visible.length;
      showCurrent();
    }

    function onClosed() {
      if (!isOpen) return;
      isOpen = false;
      document.body.style.overflow = previousOverflow;
      window.requestAnimationFrame(function () {
        lastTrigger?.focus();
      });
    }

    items.forEach(function (item) {
      item.addEventListener("click", function () {
        openLightbox(item);
      });
    });

    // El cierre puede llegar por el evento "close" o quitando el atributo
    // "open" (Esc). Observamos el atributo para restaurar estado en ambos casos.
    dialog.addEventListener("close", onClosed);
    if (typeof MutationObserver === "function") {
      new MutationObserver(function () {
        if (isOpen && !dialog!.open) onClosed();
      }).observe(dialog, { attributes: true, attributeFilter: ["open"] });
    }

    if (imgEl) {
      var lightboxImg = imgEl;
      lightboxImg.addEventListener("load", function () {
        lightboxImg.classList.remove("is-loading");
      });
      lightboxImg.addEventListener("error", function () {
        lightboxImg.classList.remove("is-loading");
      });
    }

    var closeBtn = dialog.querySelector("[data-lightbox-close]");
    var prevBtn = dialog.querySelector("[data-lightbox-prev]");
    var nextBtn = dialog.querySelector("[data-lightbox-next]");

    closeBtn?.addEventListener("click", closeLightbox);
    prevBtn?.addEventListener("click", function () {
      step(-1);
    });
    nextBtn?.addEventListener("click", function () {
      step(1);
    });

    dialog.addEventListener("click", function (event: MouseEvent) {
      var target = event.target as Element | null;
      if (!target) return;
      // El panel cubre toda la pantalla: cerrar al clicar fuera de la
      // imagen (fondo del visor o zona vacía del escenario).
      if (
        target === dialog ||
        target.hasAttribute("data-lightbox-stage") ||
        target.hasAttribute("data-lightbox-panel")
      ) {
        closeLightbox();
      }
    });

    dialog.addEventListener("keydown", function (event: KeyboardEvent) {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        step(1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(-1);
      }
    });

    filterButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        var value = button.getAttribute("data-gallery-filter") || "all";

        filterButtons.forEach(function (other) {
          var isActive = other === button;
          other.setAttribute("aria-pressed", String(isActive));
          other.classList.toggle("gallery-filter-active", isActive);
        });

        items.forEach(function (item) {
          var show = value === "all" || item.getAttribute("data-category") === value;
          if (show) {
            item.removeAttribute("hidden");
          } else {
            item.setAttribute("hidden", "");
          }
        });

        refreshVisible();
        updateCountNote();

        if (dialog!.open) closeLightbox();
      });
    });

    refreshVisible();
    updateCountNote();
  })();
</script>
