---
import { SITE } from "../../lib/seo";

const transportOptions = [
  {
    title: "En Auto",
    description:
      "Estacionamiento en la calle disponible. Ubicado en el centro de Linares, fácil acceso desde Av. Valentín Letelier.",
  },
  {
    title: "En Taxi/Uber",
    description:
      "Colectivos y taxis disponibles 24/7. Coordenadas: Valentín Letelier 182, a 2 cuadras del centro histórico.",
  },
  {
    title: "Zona Céntrica",
    description:
      "Ubicación estratégica en pleno centro de Linares, rodeado de comercio, restaurantes y servicios.",
  },
];

const mapsQuery = encodeURIComponent(`${SITE.address.street}, ${SITE.address.postalCode} ${SITE.address.locality}, ${SITE.address.region}, Chile`);
const googleMapsUrl = `https://maps.google.com/?q=${mapsQuery}`;
const wazeUrl = `https://waze.com/ul?ll=${SITE.geo.lat},${SITE.geo.lng}&navigate=yes`;
---

<section id="location" class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute right-0 bottom-0 h-[400px] w-[400px] rounded-full glow-silver" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center scroll-reveal sm:mb-16">
      <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-6xl md:text-7xl">
        <span class="text-white">Cómo</span>
        <span class="gradient-text-gold"> llegar</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base font-light text-white/60 sm:text-lg">
        Ubicados en el corazón de Linares, fácil acceso y estacionamiento disponible
      </p>
    </div>

    <div class="grid items-start gap-8 md:grid-cols-2 lg:gap-12">
      <div class="group relative h-[320px] scroll-reveal overflow-hidden rounded-3xl border border-white/10 shadow-[0_0_40px_rgba(221,226,234,0.08),0_18px_60px_rgba(0,0,0,0.6)] sm:h-[440px] lg:h-[500px]">
        <iframe
          src={`https://www.google.com/maps?q=${mapsQuery}&output=embed`}
          width="100%"
          height="100%"
          style="border: 0; filter: invert(0.92) hue-rotate(185deg) saturate(0.7) brightness(0.9);"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Las Muñecas de Ramón"
          class="opacity-90 transition-opacity duration-700 group-hover:opacity-100"
        ></iframe>
      </div>

      <div class="space-y-6 scroll-reveal" style="--reveal-delay: 100ms;">
        <div class="brand-card p-7 sm:p-8">
          <div class="mb-7 flex items-start gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gold-500/40 bg-gold-500/10">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div>
              <h3 class="font-display mb-2 text-xl uppercase tracking-wide text-white sm:text-2xl">Dirección</h3>
              <p class="text-lg font-light text-white/85">{SITE.address.street}</p>
              <p class="font-light text-white/65">{SITE.address.postalCode} {SITE.address.locality}, {SITE.address.region}, Chile</p>
              <p class="mt-3 text-sm font-light leading-relaxed text-white/55">
                Ubicado en plena Avenida Vandejón Sur, frente al Cuerpo de Bomberos
              </p>
              <p class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-gold-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                {SITE.hours.days} · {SITE.hours.open} a {SITE.hours.close}
              </p>
            </div>
          </div>
          <div class="space-y-6 border-t border-white/10 pt-6">
            {
              transportOptions.map((option) => (
                <div class="group/item flex items-start gap-4">
                  <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] transition-colors duration-300 group-hover/item:border-silver-400/50">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-silver-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                  </div>
                  <div>
                    <h4 class="mb-1 font-semibold text-white/85 transition-colors duration-300 group-hover/item:text-silver-200">
                      {option.title}
                    </h4>
                    <p class="text-sm font-light leading-relaxed text-white/50">{option.description}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="w-full">
            <span class="btn-silver w-full px-6 py-4 text-xs">
              Abrir en Google Maps
            </span>
          </a>
          <a href={wazeUrl} target="_blank" rel="noopener noreferrer" class="w-full">
            <span class="btn-silver w-full px-6 py-4 text-xs">
              Abrir en Waze
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
