  };
  return paths[name] ?? '';
};
---

<section id="careers" class="relative overflow-hidden py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center sm:mb-20">
      <div class="eyebrow-badge mb-4">Únete a Nuestro Equipo</div>
      <h2 class="mb-6 text-3xl font-bold sm:text-5xl md:text-6xl">
        <span class="gradient-text-gold">Trabaja con Nosotros</span>
      </h2>
      <p class="mx-auto max-w-3xl text-base font-light text-silver-300 sm:text-xl">
        Buscamos profesionales apasionados para formar parte del mejor nightclub de Linares
      </p>
    </div>

    <div class="mb-12 flex flex-wrap justify-center gap-5 sm:mb-16 sm:gap-8">
      {
        positions.map((pos) => {
          const waText = encodeURIComponent(`Hola, me interesa postular al cargo de ${pos.title} en Las Muñecas de Ramón`);
          const waUrl = `https://wa.me/${SITE.phoneRaw}?text=${waText}`;
          return (
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative block w-full cursor-pointer overflow-hidden rounded-3xl border border-white/10 bg-black/40 p-6 backdrop-blur-md transition-all duration-500 hover:scale-105 hover:border-gold-500/30 md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] sm:p-8"
            >
              <div class="relative z-10">
                <div class="mb-6 flex items-center gap-4">
                  <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-gold-400 to-gold-600 shadow-lg shadow-black/50 transition-transform duration-300 group-hover:scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d={iconPath(pos.icon)} />
                    </svg>
                  </div>
                  <div>
                    <h3 class="mb-1 text-xl font-bold tracking-wide text-silver-100 sm:text-2xl">{pos.title}</h3>
                    <div class="flex items-center gap-2 text-sm font-light text-silver-400">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("clock")} />
                      </svg>
                      <span>{pos.schedule}</span>
                    </div>
                  </div>
                </div>

                <div class="mb-6">
                  <h4 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-gold-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("star")} />
                    </svg>
                    Requisitos
                  </h4>
                  <ul class="space-y-2">
                    {pos.requirements.map((req) => (
                      <li class="flex items-start text-sm font-light text-silver-400">
                        <div class="mt-2 mr-3 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-gold-500" />
                        <span>{req}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mb-6">
                  <h4 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-silver-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("award")} />
                    </svg>
                    Beneficios
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    {pos.benefits.map((b) => (
                      <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-silver-300">
                        {b}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="border-t border-white/10 pt-6">
                  <div class="flex items-center justify-between">
                    <span class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-gold-500 transition-all group-hover:gap-3">
                      Postular
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 -rotate-90 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                      </svg>
                    </span>
                    <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-gold-500 to-gold-600 shadow-lg shadow-gold-500/20 transition-transform group-hover:scale-110">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("send")} />
                      </svg>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>

    <div class="mx-auto max-w-4xl rounded-3xl border border-gold-500/30 bg-black/60 p-6 text-center shadow-2xl backdrop-blur-md sm:p-10 lg:p-12">
      <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-6 h-16 w-16 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("briefcase")} />
      </svg>
      <h3 class="mb-4 text-2xl font-bold tracking-wide text-white sm:text-3xl md:text-4xl">
        ¿Te interesa trabajar con nosotros?
      </h3>
      <p class="mx-auto mb-8 max-w-2xl text-base font-light text-silver-300 sm:text-lg">
        Envía tu CV y carta de presentación a nuestro WhatsApp. Nos pondremos en contacto contigo a la brevedad.
      </p>
      <a
        href={`https://wa.me/${SITE.phoneRaw}?text=${encodeURIComponent("Hola, me interesa trabajar en Las Muñecas de Ramón")}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <button class="btn-gold inline-flex w-full items-center justify-center gap-2 px-8 py-4 text-base shadow-xl shadow-gold-600/40 sm:w-auto sm:px-10 sm:text-lg min-h-11">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("send")} />
          </svg>
          Enviar CV por WhatsApp
        </button>
      </a>
    </div>
  </div>
</section>
