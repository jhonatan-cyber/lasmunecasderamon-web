---
import { SITE } from "../../lib/seo";

const positions = [
  {
    title: "Anfitriona",
    schedule: "Mar a Dom · 22:00-05:00",
    requirements: [
      "Excelente presentación personal",
      "Habilidades de comunicación",
      "Experiencia en atención al cliente",
      "Disponibilidad horaria nocturna",
    ],
    benefits: ["Propinas", "Comisiones", "Imagen"],
  },
  {
    title: "Bailarina",
    schedule: "Mar a Dom · 22:00-05:00",
    requirements: [
      "Experiencia en baile y performance",
      "Buena condición física",
      "Actitud profesional",
      "Disponibilidad inmediata",
    ],
    benefits: ["Propinas", "Comisiones", "Ambiente VIP"],
  },
  {
    title: "Garzones",
    schedule: "Mar a Dom · 22:00-05:00",
    requirements: [
      "Experiencia en servicio de bar/restaurant",
      "Conocimiento de bebidas y cócteles",
      "Agilidad y buena memoria",
      "Trabajo en equipo",
    ],
    benefits: ["Propinas", "Uniforme", "Cena"],
  },
  {
    title: "Seguridad",
    schedule: "Mar a Dom · 22:00-05:00",
    requirements: [
      "Curso OS-10 vigente",
      "Experiencia en seguridad nocturna",
      "Excelente condición física",
      "Manejo de conflictos",
    ],
    benefits: ["Seguro", "Entrenamiento", "Equipamiento"],
  },
  {
    title: "Personal Administrativo",
    schedule: "Mar a Dom · 22:00-05:00",
    requirements: [
      "Experiencia administrativa",
      "Manejo de Office y sistemas",
      "Organización y proactividad",
      "Disponibilidad horaria nocturna",
    ],
    benefits: ["Estabilidad", "Contrato", "Oficina"],
  },
];
---

<section id="careers" class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute left-1/3 top-0 h-[400px] w-[600px] rounded-full glow-bronze" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center scroll-reveal sm:mb-20">
      <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-6xl md:text-7xl">
        <span class="text-white">Trabaja</span>
        <span class="gradient-text-gold"> con nosotros</span>
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-base font-light text-white/60 sm:text-lg">
        Buscamos profesionales apasionados para formar parte del mejor nightclub de Linares
      </p>
    </div>

    <div class="mb-12 grid gap-6 sm:mb-16 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {
        positions.map((pos, i) => {
          const waText = encodeURIComponent(`Hola, me interesa postular al cargo de ${pos.title} en Las Muñecas de Ramón`);
          const waUrl = `https://wa.me/${SITE.phoneRaw}?text=${waText}`;
          return (
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="brand-card group block p-7 scroll-reveal sm:p-8"
              style={`--reveal-delay: ${(i % 3) * 90}ms;`}
            >
              <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                  <h3 class="font-display text-2xl uppercase tracking-wide text-white transition-colors duration-300 group-hover:text-gold-300">
                    {pos.title}
                  </h3>
                  <p class="mt-1.5 text-xs uppercase tracking-[0.18em] text-white/60">{pos.schedule}</p>
                </div>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gold-500/40 bg-gold-500/10 transition-transform duration-300 group-hover:scale-110">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                  </svg>
                </span>
              </div>

              <div class="mb-6">
                <h4 class="mb-3 text-[10px] font-bold uppercase tracking-[0.25em] text-gold-400">Requisitos</h4>
                <ul class="space-y-2">
                  {pos.requirements.map((req) => (
                    <li class="flex items-start gap-3 text-sm font-light text-white/60">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold-500 shadow-[0_0_6px_rgba(221,179,73,0.8)]" />
                      <span>{req}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mb-7">
                <h4 class="mb-3 text-[10px] font-bold uppercase tracking-[0.25em] text-silver-300">Beneficios</h4>
                <div class="flex flex-wrap gap-2">
                  {pos.benefits.map((b) => (
                    <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-white/65">
                      {b}
                    </span>
                  ))}
                </div>
              </div>

              <div class="border-t border-white/10 pt-5">
                <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-gold-400 transition-all duration-300 group-hover:gap-3.5">
                  Postular
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                </span>
              </div>
            </a>
          );
        })
      }

      <div class="brand-card group flex flex-col items-center justify-center p-7 text-center scroll-reveal sm:p-8" style="--reveal-delay: 180ms;">
        <span class="mb-6 flex h-14 w-14 items-center justify-center rounded-full border border-silver-400/40 bg-silver-400/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-silver-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" />
          </svg>
        </span>
        <h3 class="font-display text-2xl uppercase tracking-wide text-white sm:text-3xl">
          ¿Tu cargo no aparece?
        </h3>
        <p class="mb-7 mt-3 text-sm font-light leading-relaxed text-white/55">
          Envía tu CV y carta de presentación a nuestro WhatsApp. Nos pondremos en contacto contigo a la brevedad.
        </p>
        <a
          href={`https://wa.me/${SITE.phoneRaw}?text=${encodeURIComponent("Hola, me interesa trabajar en Las Muñecas de Ramón")}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="btn-gold inline-flex px-7 py-3.5 text-xs">
            Enviar CV por WhatsApp
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
