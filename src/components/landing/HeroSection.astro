---
const marqueeItems = [
  "Las Muñecas de Ramón",
  "Shows en Vivo",
  "Salas VIP",
  "Bar Premium",
  "Despedidas de Soltero",
  "Linares",
];
---

<section id="home" class="relative z-10 flex min-h-[100svh] flex-col overflow-hidden">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <div class="absolute inset-0 grid-floor"></div>
    <div class="absolute -top-32 left-1/2 h-[560px] w-[560px] -translate-x-1/2 rounded-full glow-gold animate-drift"></div>
    <div class="absolute right-[8%] top-1/3 h-[420px] w-[420px] rounded-full glow-bronze animate-driftSlow"></div>
    <div class="absolute bottom-0 left-[6%] h-[380px] w-[380px] rounded-full glow-silver animate-drift"></div>
  </div>

  <div class="relative z-20 mx-auto flex w-full max-w-7xl flex-1 flex-col items-center justify-center px-4 pb-10 pt-24 text-center sm:px-6 lg:px-8">
    <p class="eyebrow-badge mb-8 animate-fade-in">
      Linares · Región del Maule
    </p>

    <div id="hero-logo" class="mb-6 flex justify-center" style="opacity: 1; transform: translateY(0) scale(1);">
      <img
        src="/img/system/logo2-768.webp"
        srcset="/img/system/logo2-480.webp 480w, /img/system/logo2-768.webp 768w, /img/system/logo2-1124.webp 1124w"
        sizes="(min-width: 1024px) 820px, (min-width: 640px) 680px, 92vw"
        alt="Las Muñecas de Ramón"
        width="1124"
        height="721"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="max-h-[38svh] max-w-[560px] px-2 object-contain drop-shadow-[0_0_35px_rgba(221,179,73,0.35)] sm:px-0 md:max-w-[680px] lg:max-w-[820px]"
        style="width: 100%; height: auto;"
      />
    </div>

    <h1 class="font-display uppercase leading-[0.95] text-white sm:text-6xl md:text-7xl lg:text-8xl" style="font-size: clamp(2.2rem, 5vw, 4.5rem);">
      La noche
      <span class="gradient-text-gold animate-shimmer">te pertenece</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-base font-light leading-relaxed text-white/60 sm:text-lg">
      Vive la mejor experiencia VIP de Linares: shows en vivo, tragos premium
      y el ambiente más exclusivo del Maule.
    </p>

    <div class="mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-6">
      <a href="#events" class="w-full sm:w-auto">
        <span class="btn-silver w-full px-10 py-4 text-sm sm:w-auto sm:text-base">
          Ver Eventos
        </span>
      </a>
    </div>
  </div>

  <div class="relative z-20 border-y border-white/10 bg-black/40 py-4 backdrop-blur-md" aria-hidden="true">
    <div class="marquee">
      {[0, 1].map(() => (
        <div class="marquee-track gap-8 pr-8">
          {marqueeItems.map((item) => (
            <span class="flex items-center gap-8">
              <span class="font-display text-lg uppercase tracking-wider text-white/85 sm:text-xl">{item}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6L12 2z" />
              </svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  (function () {
    const logo = document.getElementById("hero-logo");
    if (!logo) return;
    // Con scroll-driven animations el fade vive en CSS puro (#hero-logo
    // en global.css); este bloque es solo el fallback con rAF para
    // navegadores sin soporte, y se omite con prefers-reduced-motion.
    if (CSS.supports("animation-timeline", "scroll()")) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let ticking = false;
    const render = () => {
      ticking = false;
      const y = window.scrollY;
      const opacity = Math.max(0, 1 - y / 420);
      logo.style.opacity = String(Number.isFinite(opacity) ? opacity : 1);
      logo.style.transform = `translateY(${-y * 0.28}px)`;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(render);
      },
      { passive: true }
    );
    render();
  })();
</script>
