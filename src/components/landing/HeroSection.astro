---
/**
 * HeroSection — full-height hero with logo, 4 feature cards, and CTA.
 * Mirrors HeroSection.tsx with a vanilla scroll handler for the logo animation.
 */
const features = [
  { icon: "music", title: "Música Premium", desc: "DJs de clase mundial" },
  { icon: "sparkles", title: "Ambiente VIP", desc: "Lujo y exclusividad" },
  { icon: "users", title: "Servicio Exclusivo", desc: "Atención personalizada" },
  { icon: "wine", title: "Bar Premium", desc: "Licores de primera" },
];

const iconSvg = (name: string, className = "w-6 h-6 sm:w-7 sm:h-7") => {
  const paths: Record<string, string> = {
    music: 'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
    sparkles: 'M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z',
    users: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z',
    wine: 'M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 0 1 4.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0 1 12 15a9.065 9.065 0 0 0-6.23.693L5 14.5m14.8.8 1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0 1 12 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
  };
  return `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="${className}"><path stroke-linecap="round" stroke-linejoin="round" d="${paths[name] ?? ''}"/></svg>`;
};
---

<section id="home" class="relative z-10 flex min-h-[92svh] items-center justify-center overflow-hidden pt-20 lg:min-h-screen">
  {/* Background Elements */}
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/2 left-1/2 h-[800px] w-[800px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold-500/5 blur-[120px] animate-pulse"></div>
  </div>

  <div class="relative z-20 mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <div
      id="hero-logo"
      class="mb-10 flex justify-center transition-all duration-100 sm:mb-12 lg:sticky lg:top-20"
      style="opacity: 1; transform: translateY(0) scale(1);"
    >
      <img
        src="/img/system/logo2.png"
        alt="Las Muñecas de Ramón"
        width="1124"
        height="721"
        loading="eager"
        class="animate-in fade-in zoom-in max-w-[680px] animate-[fadeIn_0.5s_ease-out,zoomIn_0.5s_ease-out] px-2 drop-shadow-[0_0_25px_rgba(217,119,6,0.3)] duration-1000 sm:px-0 md:max-w-[780px] lg:max-w-[950px]"
        style="width: 100%; height: auto;"
      />
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl grid-cols-1 gap-4 sm:mt-16 sm:grid-cols-2 sm:gap-6 lg:mt-20 lg:grid-cols-4">
      {
        features.map((feature) => (
          <div class="group relative rounded-2xl border border-white/10 bg-black/40 p-5 backdrop-blur-md transition-all duration-500 hover:-translate-y-2 hover:border-gold-500/50 hover:shadow-[0_10px_40px_-10px_rgba(245,158,11,0.2)] sm:p-6 lg:p-8">
            <div class="absolute inset-0 rounded-2xl bg-gradient-to-b from-gold-500/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
            <div class="relative z-10">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-gold-500/20 bg-gradient-to-br from-zinc-900 to-black shadow-lg shadow-black/50 transition-colors duration-500 group-hover:border-gold-500/60 sm:mb-6 sm:h-16 sm:w-16">
                <span class="text-gold-400 transition-colors duration-300 group-hover:text-gold-300" set:html={iconSvg(feature.icon)} />
              </div>
              <h3 class="mb-2 text-base font-bold tracking-wide text-silver-200 transition-colors duration-300 group-hover:text-gold-400 sm:text-lg">
                {feature.title}
              </h3>
              <p class="text-sm font-light text-silver-500 transition-colors duration-300 group-hover:text-silver-300">
                {feature.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col justify-center gap-4 sm:mt-16 sm:flex-row sm:gap-6 lg:mt-20">
      <a href="#about" class="group relative w-full sm:w-auto">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-gold-600 via-gold-400 to-gold-600 opacity-25 blur transition duration-1000 group-hover:opacity-75 group-hover:duration-200"></div>
        <button class="relative flex min-h-11 w-full min-w-0 items-center justify-center gap-2 rounded-full border border-gold-500/50 bg-black px-10 py-4 text-base font-medium uppercase tracking-widest text-gold-400 transition-all duration-300 hover:text-gold-300 hover:shadow-[0_0_20px_rgba(245,158,11,0.3)] sm:w-auto sm:px-12 sm:text-lg">
          <span class="flex items-center gap-2">
            Conocer Más
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </button>
      </a>
    </div>
  </div>
</section>

<script>
  // Hero: scroll-driven logo transform
  (function () {
    const logo = document.getElementById("hero-logo");
    if (!logo) return;
    const onScroll = () => {
      const y = window.scrollY;
      const opacity = Math.max(0, 1 - y / 300);
      const scale = Math.max(0.4, 1 - y / 500);
      const translateY = -y * 0.5;
      logo.style.opacity = String(Number.isFinite(opacity) ? opacity : 1);
      logo.style.transform = `translateY(${translateY}px) scale(${scale})`;
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
