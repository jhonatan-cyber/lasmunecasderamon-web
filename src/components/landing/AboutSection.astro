---


const images = [
  { url: "https://images.unsplash.com/photo-1566737236500-c8ac43014a67", alt: "Ambiente de Lujo" },
  { url: "https://images.unsplash.com/photo-1570572225676-47621c255771", alt: "Iluminación Premium" },
  { url: "https://images.unsplash.com/photo-1572116469696-31de0f17cc34", alt: "Bar Exclusivo" },
  { url: "https://images.unsplash.com/photo-1566417713940-fe7c737a9ef2", alt: "Sala VIP" },
];

const stats = [
  { number: "7+", label: "Años de Experiencia", icon: "calendar" },
  { number: "500+", label: "Clientes VIP", icon: "users" },
  { number: "4.9", label: "Rating", icon: "star" },
];

const iconPath = (name: string) => {
  const paths: Record<string, string> = {
    calendar: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5',
    users: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z',
    star: 'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z',
    award: 'M16.5 18.75h-9m9 0a3 3 0 0 1 3 3h-15a3 3 0 0 1 3-3m9 0v-4.5A3.375 3.375 0 0 0 19.125 11.25H4.875A3.375 3.375 0 0 0 1.5 14.25V18.75m18 0h-18M8.25 11.25h7.5',
    shield: 'M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.063 2.522-.187 3.757-.103 1.034-.684 1.957-1.587 2.55a36.66 36.66 0 0 1-7.226 3.487 2.205 2.205 0 0 1-1.974 0A36.626 36.626 0 0 1 2.774 18.31c-.903-.594-1.484-1.517-1.587-2.55A41.04 41.04 0 0 1 1 12c0-1.268.063-2.522.187-3.757.103-1.034.684-1.957 1.587-2.55a36.66 36.66 0 0 1 7.226-3.487 2.205 2.205 0 0 1 1.974 0c2.357.949 4.868 2.105 7.226 3.487.903.593 1.484 1.516 1.587 2.55.124 1.235.187 2.49.187 3.757Z',
  };
  return paths[name] ?? '';
};
---

<section id="about" class="relative overflow-hidden py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 md:grid-cols-2 lg:gap-16">
      <div class="relative order-2 md:order-1">
        <div class="absolute -inset-4 rounded-full bg-gradient-to-r from-gold-500/10 to-silver-400/10 blur-3xl"></div>
        <div class="relative rounded-3xl border border-white/10 bg-black/40 p-6 shadow-2xl backdrop-blur-md transition-all duration-500 hover:border-gold-500/30 sm:p-8 lg:p-10">
          <div class="mb-8 flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-gold-500 via-gold-600 to-gold-700 shadow-lg shadow-gold-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("award")} />
              </svg>
            </div>
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
              <span class="gradient-text-gold">Sobre Nosotros</span>
            </h2>
          </div>

          <p class="mb-6 text-base font-light leading-relaxed text-silver-300 sm:text-lg">
            <span class="font-medium text-gold-400">Las Muñecas de Ramón</span> se consolida como uno de los nightclubs más exclusivos y reconocidos de la Región del Maule, ofreciendo un servicio de calidad y primera clase. Contamos con nuevas instalaciones totalmente renovadas y una infraestructura de primer nivel.
          </p>
          <p class="mb-8 text-base font-light leading-relaxed text-silver-400 sm:text-lg">
            Con 7 años de experiencia, somos una empresa joven siempre a la vanguardia, certificada por la preferencia de nuestros clientes. Disponemos de un local climatizado con los más altos estándares de higiene y un quincho exclusivo con todas las comodidades para que disfrutes de un asado privado con las chicas y tus amigos.
          </p>

          <div class="mt-10 grid grid-cols-1 gap-4 border-t border-white/10 pt-8 sm:grid-cols-3 sm:gap-6">
            {
              stats.map((stat) => (
                <div class="group text-center transition-transform duration-300 hover:scale-110">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-3 h-8 w-8 text-gold-500/80 transition-colors group-hover:text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPath(stat.icon)} />
                  </svg>
                  <div class="text-3xl font-bold text-silver-200 transition-colors group-hover:text-gold-400">
                    {stat.number}
                  </div>
                  <div class="mt-1 text-xs uppercase tracking-wider text-silver-500">{stat.label}</div>
                </div>
              ))
            }
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <div class="flex items-center gap-2 rounded-full border border-gold-500/20 bg-gold-500/10 px-4 py-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("shield")} />
              </svg>
              <span class="text-xs uppercase tracking-wide text-gold-400">Seguridad Garantizada</span>
            </div>
            <div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-silver-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("award")} />
              </svg>
              <span class="text-xs uppercase tracking-wide text-silver-400">Certificado de Excelencia</span>
            </div>
          </div>
        </div>
      </div>

      <div class="group relative order-1 h-[360px] sm:h-[500px] lg:h-[600px] md:order-2">
        <div class="absolute inset-0 animate-pulse rounded-3xl bg-gradient-to-br from-gold-500/10 to-silver-400/10 blur-3xl"></div>
        <div class="relative h-full overflow-hidden rounded-3xl border border-white/10 bg-zinc-900/50 shadow-2xl">
          {
            images.map((img, index) => (
              <div
                class:list={["slider-image absolute inset-0", index === 0 && "active"]}
                data-slider-index={index}
              >
                <img
                  src={img.url}
                  alt={img.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  class="ken-burns h-full w-full object-cover transition-transform"
                  style="transition-duration: 10000ms;"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent" />
              </div>
            ))
          }

          <button
            type="button"
            data-slider-prev
            aria-label="Imagen anterior"
            class="absolute left-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/50 text-white transition-all duration-300 hover:bg-gold-500 hover:text-black md:opacity-0 md:group-hover:opacity-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            type="button"
            data-slider-next
            aria-label="Imagen siguiente"
            class="absolute right-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/50 text-white transition-all duration-300 hover:bg-gold-500 hover:text-black md:opacity-0 md:group-hover:opacity-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          <div class="absolute bottom-6 left-0 right-0 z-30 flex justify-center gap-2 sm:bottom-24" data-slider-dots></div>

          <div class="absolute bottom-0 left-0 right-0 z-20 transform p-4 transition-transform duration-500 group-hover:translate-y-0 sm:p-8">
            <p class="mb-2 text-lg font-medium tracking-wide text-gold-400 sm:text-xl">Experiencia Premium</p>
            <p class="text-sm font-light text-silver-400">Un ambiente único de lujo y distinción</p>
          </div>

          <div class="absolute right-8 top-8 z-20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 animate-pulse text-gold-500/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPath("sparkles")} />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  
  (function () {
    document.querySelectorAll("[data-slider-index]").forEach(function (first) {
      var section = first.parentElement;
      if (!section) return;
      var slides = Array.from(section.querySelectorAll("[data-slider-index]"));
      if (slides.length === 0) return;
      if (section.dataset.sliderInit === "1") return;
      section.dataset.sliderInit = "1";

      var dotsContainer = section.querySelector("[data-slider-dots]");
      var prevBtn = section.querySelector("[data-slider-prev]");
      var nextBtn = section.querySelector("[data-slider-next]");
      var current = 0;
      var timer = null;

      if (dotsContainer) {
        slides.forEach(function (_, i) {
          var dot = document.createElement("button");
          dot.type = "button";
          dot.setAttribute("aria-label", "Ir a imagen " + (i + 1));
          dot.className = "h-2 w-2 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/50";
          if (i === 0) dot.className += " w-6 bg-gold-500";
          dot.addEventListener("click", function () { goTo(i, true); });
          dotsContainer.appendChild(dot);
        });
      }

      var dots = dotsContainer ? Array.from(dotsContainer.children) : [];

      function goTo(i, fromUser) {
        if (slides[current]) slides[current].classList.remove("active");
        if (dots[current]) {
          dots[current].classList.remove("w-6", "bg-gold-500");
          dots[current].classList.add("bg-white/30");
        }
        current = ((i % slides.length) + slides.length) % slides.length;
        if (slides[current]) slides[current].classList.add("active");
        if (dots[current]) {
          dots[current].classList.add("w-6", "bg-gold-500");
          dots[current].classList.remove("bg-white/30");
        }
        if (fromUser) restart();
      }
      function next() { goTo(current + 1, false); }
      function prev() { goTo(current - 1, false); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() { stop(); timer = window.setInterval(next, 5000); }
      function restart() { start(); }

      if (prevBtn) prevBtn.addEventListener("click", function () { prev(); restart(); });
      if (nextBtn) nextBtn.addEventListener("click", function () { next(); restart(); });

      section.addEventListener("mouseenter", stop);
      section.addEventListener("mouseleave", start);

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) start();
    });
  })();
</script>
