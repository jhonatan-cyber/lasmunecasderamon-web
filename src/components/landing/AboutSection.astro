---
const photoSrc = (id: string, w: number) => `/img/${id}-${w}.webp`;
const sliderSrcset = (id: string) =>
  [480, 800, 1200].map((w) => `${photoSrc(id, w)} ${w}w`).join(", ");
const sliderSizes = "(min-width: 1024px) 50vw, 100vw";

const images = [
  { id: "about-1", alt: "Instalaciones del club" },
  { id: "about-2", alt: "Ambiente e iluminación" },
  { id: "about-3", alt: "Bar y coctelería premium" },
  { id: "about-4", alt: "Sala VIP" },
];

const stats = [
  { number: "7+", label: "Años de Experiencia" },
  { number: "500+", label: "Clientes VIP" },
  { number: "4.9", label: "Rating" },
];
---

<section id="about" class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute left-1/2 top-0 h-[400px] w-[700px] -translate-x-1/2 rounded-full glow-bronze" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 scroll-reveal sm:mb-16">
      <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-6xl md:text-7xl">
        <span class="text-white">Mucho más que</span>
        <br />
        <span class="gradient-text-gold">un club nocturno</span>
      </h2>
    </div>

    <div class="grid items-center gap-10 md:grid-cols-2 lg:gap-14">
      <div class="scroll-reveal relative order-2 md:order-1" style="--reveal-delay: 80ms;">
        <div class="brand-card p-7 sm:p-9">
          <p class="mb-6 text-base font-light leading-relaxed text-white/70 sm:text-lg">
            <span class="font-medium text-gold-400">Las Muñecas de Ramón</span> se consolida como uno de los
            nightclubs más exclusivos y reconocidos de la Región del Maule, ofreciendo un servicio de calidad y
            primera clase. Contamos con nuevas instalaciones totalmente renovadas y una infraestructura de primer nivel.
          </p>
          <p class="mb-10 text-base font-light leading-relaxed text-white/55 sm:text-lg">
            Con 7 años de experiencia, somos una empresa joven siempre a la vanguardia, certificada por la preferencia
            de nuestros clientes. Disponemos de un local climatizado con los más altos estándares de higiene y un
            quincho exclusivo con todas las comodidades para que disfrutes de un asado privado con las chicas y tus amigos.
          </p>

          <div class="grid grid-cols-3 gap-4 border-t border-white/10 pt-8">
            {
              stats.map((stat) => (
                <div class="group text-center">
                  <div class="font-display text-3xl gold-text-glow sm:text-4xl">{stat.number}</div>
                  <div class="mt-2 text-[11px] uppercase tracking-[0.18em] text-white/60">{stat.label}</div>
                </div>
              ))
            }
          </div>

          <div class="mt-9 flex flex-wrap gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-gold-500/30 bg-gold-500/10 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-gold-300">
              Seguridad Garantizada
            </span>
            <span class="inline-flex items-center gap-2 rounded-full border border-silver-400/30 bg-silver-400/10 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.16em] text-silver-200">
              Certificado de Excelencia
            </span>
          </div>
        </div>
      </div>

      <div class="group relative order-1 h-[360px] sm:h-[500px] lg:h-[580px] md:order-2 scroll-reveal" style="--reveal-delay: 160ms;">
        <div class="absolute inset-0 animate-pulse rounded-3xl bg-gradient-to-br from-gold-500/10 to-silver-400/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative h-full overflow-hidden rounded-3xl border border-white/10 shadow-[0_18px_60px_rgba(0,0,0,0.6)]">
          {
            images.map((img, index) => (
              <div
                class:list={["slider-image absolute inset-0", index === 0 && "active"]}
                data-slider-index={index}
              >
                <img
                  src={photoSrc(img.id, 800)}
                  srcset={sliderSrcset(img.id)}
                  sizes={sliderSizes}
                  alt={img.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="ken-burns h-full w-full object-cover"
                  style="transition-duration: 10000ms;"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-transparent to-transparent" />
              </div>
            ))
          }

          <button
            type="button"
            data-slider-prev
            aria-label="Imagen anterior"
            class="absolute left-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/60 text-white transition-all duration-300 hover:border-gold-500/60 hover:text-gold-300 md:opacity-0 md:group-hover:opacity-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            type="button"
            data-slider-next
            aria-label="Imagen siguiente"
            class="absolute right-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/60 text-white transition-all duration-300 hover:border-gold-500/60 hover:text-gold-300 md:opacity-0 md:group-hover:opacity-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          <div class="absolute bottom-6 left-0 right-0 z-30 flex justify-center gap-2" data-slider-dots></div>

          <div class="absolute bottom-12 left-0 right-0 z-20 p-5 sm:bottom-16 sm:p-8">
            <p class="font-display text-xl uppercase tracking-wide text-white drop-shadow-lg sm:text-2xl">
              Experiencia <span class="gold-text-glow">Premium</span>
            </p>
            <p class="mt-1 text-sm font-light text-white/60">Un ambiente único de lujo y distinción</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    document.querySelectorAll("[data-slider-index]").forEach(function (first) {
      var section = first.parentElement;
      if (!section) return;
      var slides = Array.from(section.querySelectorAll("[data-slider-index]"));
      if (slides.length === 0) return;
      if (section.dataset.sliderInit === "1") return;
      section.dataset.sliderInit = "1";

      const dotsContainer = section.querySelector("[data-slider-dots]");
      const prevBtn = section.querySelector("[data-slider-prev]");
      const nextBtn = section.querySelector("[data-slider-next]");
      let current = 0;
      let timer: any = null;

      if (dotsContainer) {
        slides.forEach(function (_, i) {
          const dot = document.createElement("button");
          dot.type = "button";
          dot.setAttribute("aria-label", "Ir a imagen " + (i + 1));
          dot.className = "h-2 w-2 rounded-full bg-white/25 transition-all duration-300 hover:bg-white/50";
          if (i === 0) dot.className += " w-6 bg-gold-500 shadow-[0_0_10px_rgba(221,179,73,0.8)]";
          dot.addEventListener("click", function () { goTo(i, true); });
          dotsContainer!.appendChild(dot);
        });
      }

      const dots = dotsContainer ? Array.from(dotsContainer.children) : [];

      function goTo(i: number, fromUser?: boolean) {
        if (slides[current]) slides[current].classList.remove("active");
        if (dots[current]) {
          dots[current].classList.remove("w-6", "bg-gold-500", "shadow-[0_0_10px_rgba(221,179,73,0.8)]");
          dots[current].classList.add("bg-white/25");
        }
        current = ((i % slides.length) + slides.length) % slides.length;
        if (slides[current]) slides[current].classList.add("active");
        if (dots[current]) {
          dots[current].classList.add("w-6", "bg-gold-500", "shadow-[0_0_10px_rgba(221,179,73,0.8)]");
          dots[current].classList.remove("bg-white/25");
        }
        if (fromUser) restart();
      }
      function next() { goTo(current + 1, false); }
      function prev() { goTo(current - 1, false); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      function start() { stop(); timer = window.setInterval(next, 5000); }
      function restart() { start(); }

      if (prevBtn) prevBtn.addEventListener("click", function () { prev(); restart(); });
      if (nextBtn) nextBtn.addEventListener("click", function () { next(); restart(); });

      section.addEventListener("mouseenter", stop);
      section.addEventListener("mouseleave", start);

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) start();
    });
  })();
</script>
