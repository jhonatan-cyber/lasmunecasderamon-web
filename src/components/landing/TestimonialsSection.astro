---
const defaultReviews = [
  {
    nombre: "Carlos M.",
    comentario: "Una experiencia única. El mejor lugar para pasar una noche inolvidable.",
    rating: 5,
    date: "Hace 2 semanas",
    servicio: "Sala VIP",
  },
  {
    nombre: "Ricardo S.",
    comentario: "Ambiente excepcional, servicio de primera. Totalmente recomendado.",
    rating: 5,
    date: "Hace 1 mes",
    servicio: "Bar Premium",
  },
  {
    nombre: "Jorge P.",
    comentario: "La atención y el ambiente VIP superaron todas mis expectativas.",
    rating: 5,
    date: "Hace 3 semanas",
    servicio: "Entretenimiento",
  },
];

const starPath = "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";

const userPath = "M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z";
---

<section class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute right-1/4 top-0 h-[380px] w-[380px] rounded-full glow-bronze" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center scroll-reveal">
      <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-6xl md:text-7xl">
        <span class="text-white">La noche habla</span>
        <span class="gradient-text-gold"> por sí sola</span>
      </h2>
    </div>

    <div class="carousel-row scroll-reveal -mx-4 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 pt-4 sm:mx-0 sm:gap-6 sm:px-0">
      {
        defaultReviews.map((t) => (
          <div class="brand-card group flex w-[85vw] shrink-0 snap-start flex-col p-7 sm:w-[430px] sm:p-8">
            <span class="font-display pointer-events-none absolute -top-3 right-5 select-none text-8xl leading-none text-gold-500/10 transition-colors duration-500 group-hover:text-gold-500/20">
              &ldquo;
            </span>

            <div class="mb-5 flex gap-1">
              {Array.from({ length: t.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold-400 drop-shadow-[0_0_6px_rgba(221,179,73,0.6)]" fill="currentColor" viewBox="0 0 24 24" stroke="none">
                  <path stroke-linecap="round" stroke-linejoin="round" d={starPath} />
                </svg>
              ))}
            </div>

            <p class="mb-8 flex-1 pb-1 text-base font-light italic leading-relaxed text-white/70 sm:text-lg">
              {t.comentario}
            </p>

            <div class="flex items-center gap-4 border-t border-white/10 pt-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-full border border-gold-500/30 bg-gold-500/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gold-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={userPath} />
                </svg>
              </div>
              <div>
                <p class="font-bold tracking-wide text-white/85">{t.nombre}</p>
                <p class="mt-0.5 text-[10px] uppercase tracking-[0.2em] text-white/60">{t.servicio} · {t.date}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
