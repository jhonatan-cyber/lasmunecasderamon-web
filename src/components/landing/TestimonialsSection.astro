---


const defaultReviews = [
  {
    nombre: "Carlos M.",
    comentario: "Una experiencia única. El mejor lugar para pasar una noche inolvidable.",
    rating: 5,
    date: "Hace 2 semanas",
    servicio: "Sala VIP",
  },
  {
    nombre: "Ricardo S.",
    comentario: "Ambiente excepcional, servicio de primera. Totalmente recomendado.",
    rating: 5,
    date: "Hace 1 mes",
    servicio: "Bar Premium",
  },
  {
    nombre: "Jorge P.",
    comentario: "La atención y el ambiente VIP superaron todas mis expectativas.",
    rating: 5,
    date: "Hace 3 semanas",
    servicio: "Entretenimiento",
  },
];

const starPath = "M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z";

const userPath = "M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z";
---

<section class="relative overflow-hidden py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold sm:text-5xl md:text-6xl">
        <span class="gradient-text-gold">Lo que dicen nuestros clientes</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
      {
        defaultReviews.map((t) => (
          <div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-black/40 p-6 backdrop-blur-md transition-all duration-500 hover:-translate-y-2 hover:border-gold-500/30 hover:shadow-2xl hover:shadow-gold-600/10 sm:p-8">
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-gold-500/5 via-silver-400/5 to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100" />
            <div class="absolute right-4 top-4 flex gap-1">
              {Array.from({ length: t.rating }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gold-500 drop-shadow-md" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0">
                  <path stroke-linecap="round" stroke-linejoin="round" d={starPath} />
                </svg>
              ))}
            </div>
            <p class="relative z-10 mb-8 text-base font-light italic leading-relaxed text-silver-300 sm:text-lg">
              "{t.comentario}"
            </p>
            <div class="group flex items-center gap-4 border-t border-white/10 pt-6 transition-colors group-hover:border-gold-500/20">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border border-white/5 bg-zinc-900 shadow-lg transition-colors group-hover:border-gold-500/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-silver-400 transition-colors group-hover:text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={userPath} />
                </svg>
              </div>
              <div>
                <p class="font-bold tracking-wide text-silver-200 transition-colors group-hover:text-gold-400">
                  {t.nombre}
                </p>
                <p class="mt-0.5 text-xs uppercase tracking-wider text-silver-500">{t.date}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
