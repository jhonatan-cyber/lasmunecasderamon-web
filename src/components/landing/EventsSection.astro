---
import { SITE } from "../../lib/seo";

const photoSrc = (id: string, w: number) => `/img/${id}-${w}.webp`;
const sliderSrcset = (id: string) =>
  [480, 800, 1200].map((w) => `${photoSrc(id, w)} ${w}w`).join(", ");
const sliderSizes = "(min-width: 1024px) 50vw, 100vw";

const lineup = [
  {
    tag: "El Clásico",
    title: "Despedidas de Soltero",
    desc: "La despedida que se recuerda para siempre: shows exclusivos, barra premium y privacidad total.",
  },
  {
    tag: "A Tu Medida",
    title: "Fiestas Privadas",
    desc: "Espacios únicos, totalmente remodelados y climatizados, con servicios higiénicos privados para tu grupo.",
  },
  {
    tag: "Grupo Completo",
    title: "Quincho & Asado Privado",
    desc: "Un quincho exclusivo con todas las comodidades para un asado privado con las chicas y tus amigos.",
  },
];

const galleryImages = [
  { id: "events-1", alt: "Despedida de soltero en el club" },
  { id: "events-2", alt: "Fiesta privada" },
  { id: "events-3", alt: "Quincho para eventos privados" },
  { id: "events-4", alt: "Sala VIP para eventos" },
];

const whatsappUrl = `https://wa.me/${SITE.phoneRaw}?text=${encodeURIComponent("Hola, me interesa cotizar una despedida de soltero")}`;
---

<section id="events" class="relative overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute right-0 top-24 h-[420px] w-[420px] rounded-full glow-gold" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-14 scroll-reveal sm:mb-16">
      <h2 class="font-display text-4xl uppercase leading-[1.02] sm:text-6xl md:text-7xl">
        <span class="text-white">Tu noche,</span>
        <br />
        <span class="gradient-text-gold">al límite</span>
      </h2>
      <p class="mt-6 max-w-2xl text-base font-light text-white/60 sm:text-lg">
        Despedidas de soltero, fiestas privadas y celebraciones diseñadas para que vivas la experiencia
        de la privacidad y la exclusividad.
      </p>
    </div>

    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-4 scroll-reveal" style="--reveal-delay: 80ms;">
        {
          lineup.map((item, i) => (
            <div class="brand-card group flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-8">
              <div class="flex items-center gap-4 sm:w-44 sm:shrink-0 sm:flex-col sm:items-start sm:gap-1">
                <span class="font-display text-4xl text-white/45 sm:text-5xl">0{i + 1}</span>
                <span class="inline-flex items-center rounded-full border border-silver-400/30 bg-silver-400/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-silver-200">
                  {item.tag}
                </span>
              </div>
              <div class="min-w-0">
                <h3 class="font-display text-2xl uppercase tracking-wide text-white transition-colors duration-300 group-hover:text-gold-300 sm:text-3xl">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm font-light leading-relaxed text-white/55">{item.desc}</p>
              </div>
            </div>
          ))
        }

        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="block pt-3">
          <span class="btn-gold w-full px-8 py-4 text-sm sm:text-base">
            Cotizar Evento por WhatsApp
          </span>
        </a>
      </div>

      <div class="group relative h-[340px] scroll-reveal sm:h-[420px] lg:h-[560px]" style="--reveal-delay: 160ms;">
        <div class="absolute inset-0 animate-pulse rounded-3xl bg-gradient-to-br from-gold-500/10 to-bronze-500/10 blur-3xl" aria-hidden="true"></div>
        <div class="relative h-full overflow-hidden rounded-3xl border border-white/10 shadow-[0_18px_60px_rgba(0,0,0,0.6)]">
          {
            galleryImages.map((img, index) => (
              <div
                class:list={["slider-image absolute inset-0", index === 0 && "active"]}
                data-slider-index={index}
              >
                <img
                  src={photoSrc(img.id, 800)}
                  srcset={sliderSrcset(img.id)}
                  sizes={sliderSizes}
                  alt={img.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="ken-burns h-full w-full object-cover"
                  style="transition-duration: 10000ms;"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent" />
              </div>
            ))
          }

          <button
            type="button"
            data-slider-prev
            aria-label="Imagen anterior"
            class="absolute left-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/60 text-white transition-all duration-300 hover:border-gold-500/60 hover:text-gold-300 md:opacity-0 md:group-hover:opacity-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </button>
          <button
            type="button"
            data-slider-next
            aria-label="Imagen siguiente"
            class="absolute right-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/10 bg-black/60 text-white transition-all duration-300 hover:border-gold-500/60 hover:text-gold-300 md:opacity-0 md:group-hover:opacity-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          <div class="absolute bottom-6 left-0 right-0 z-30 flex justify-center gap-2" data-slider-dots></div>
        </div>
      </div>
    </div>
  </div>
</section>
